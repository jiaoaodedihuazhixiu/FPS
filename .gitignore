# ============================================================
# Unreal Engine 项目忽略规则 (UE 5.8)
# ============================================================

# ---- 引擎生成的构建产物 ----
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/

# ---- Unreal 自动生成的工程文件 ----
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# ---- IDE 私有目录 ----
.vs/
.idea/
*.lnk

# ---- 操作系统 / 杂项 ----
Thumbs.db
desktop.ini
.DS_Store
*.log
*.tmp

# ---- 本机工具产物 / Office 临时锁文件 ----
_dsh_tmp/
_review_tmp/
Overview/~$*
Config/DefaultEditorPerProjectUserSettings.ini
